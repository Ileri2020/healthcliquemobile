<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ThemeColors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <StaticResource x:Key="Primary" Key="ThemePrimaryLight" />
    <StaticResource x:Key="PrimaryDark" Key="ThemePrimaryDark" />
    <StaticResource x:Key="PrimaryDarkText" Key="ThemeForegroundLight" />
    <StaticResource x:Key="Secondary" Key="ThemeSecondaryLight" />
    <StaticResource x:Key="SecondaryDarkText" Key="ThemePrimaryDark" />
    <StaticResource x:Key="Tertiary" Key="ThemeAccentLight" />
    <StaticResource x:Key="White" Key="ThemeWhite" />
    <StaticResource x:Key="Black" Key="ThemeBlack" />
    <StaticResource x:Key="Magenta" Key="ThemeDestructiveLight" />
    <StaticResource x:Key="MidnightBlue" Key="ThemeBackgroundDark" />
    <StaticResource x:Key="OffBlack" Key="ThemeSurfaceDark" />
    <StaticResource x:Key="Gray100" Key="ThemeBorderLight" />
    <StaticResource x:Key="Gray200" Key="ThemeMutedLight" />
    <StaticResource x:Key="Gray300" Key="ThemeBorderLight" />
    <StaticResource x:Key="Gray400" Key="ThemeMutedForegroundLight" />
    <StaticResource x:Key="Gray500" Key="ThemeMutedForegroundDark" />
    <StaticResource x:Key="Gray600" Key="ThemeMutedForegroundDark" />
    <StaticResource x:Key="Gray900" Key="ThemeForegroundLight" />
    <StaticResource x:Key="Gray950" Key="ThemeForegroundLight" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
</ResourceDictionary>