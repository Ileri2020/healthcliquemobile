<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:EEE.ClientApp"
             xmlns:utility="clr-namespace:EEE.Components.Utility"
             x:Class="EEE.ClientApp.Pages.ContactPage"
             Title="Contact"
             BackgroundColor="{AppThemeBinding Light={StaticResource ThemeBackgroundLight}, Dark={StaticResource ThemeBackgroundDark}}">
    <app:RootLayout x:Name="PageLayout" CurrentPath="/contact">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="18">
                <Label Text="Let's talk" FontSize="30" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource ThemePrimaryLight}, Dark={StaticResource ThemePrimaryDark}}" />
                <Label Text="Send our team a message or chat with a pharmacist. Contact messages are sent securely to the HealthClique service."
                       TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
                <utility:ContactForm x:Name="ContactMessageForm" />
                <Label Text="Chat with our team" FontSize="24" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource ThemePrimaryLight}, Dark={StaticResource ThemePrimaryDark}}" />
                <Label Text="Sign in to start or continue a private conversation with our pharmacy team."
                       TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
                <utility:ChatInterface x:Name="SupportChat" />
            </VerticalStackLayout>
        </ScrollView>
    </app:RootLayout>
</ContentPage>
