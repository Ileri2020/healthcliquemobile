<?xml version="1.0" encoding="utf-8" ?>
<controls:ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:controls="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:app="clr-namespace:EEE.ClientApp"
                      x:Class="EEE.ClientApp.Pages.AboutPage"
                      Title="About"
                      BackgroundColor="{AppThemeBinding Light={StaticResource ThemeBackgroundLight}, Dark={StaticResource ThemeBackgroundDark}}">
    <controls:ContentPage.Content>
        <app:RootLayout x:Name="PageLayout">
            <ScrollView>
                <VerticalStackLayout x:Name="Workspace" Padding="16" Spacing="12" />
            </ScrollView>
        </app:RootLayout>
    </controls:ContentPage.Content>
</controls:ContentPage>

