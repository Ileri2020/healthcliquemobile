<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:EEE.ClientApp"
             xmlns:utility="clr-namespace:EEE.Components.Utility"
             x:Class="EEE.ClientApp.Pages.SignupPage"
             Title="Create account"
             BackgroundColor="{AppThemeBinding Light={StaticResource ThemeBackgroundLight}, Dark={StaticResource ThemeBackgroundDark}}">
    <app:RootLayout x:Name="PageLayout" CurrentPath="/signup">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <utility:Signup x:Name="SignupForm" />
            </VerticalStackLayout>
        </ScrollView>
    </app:RootLayout>
</ContentPage>
