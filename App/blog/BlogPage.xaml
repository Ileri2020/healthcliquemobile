<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:EEE.ClientApp"
             xmlns:utility="clr-namespace:EEE.Components.Utility"
             x:Class="EEE.ClientApp.Pages.BlogPage"
             Title="Clinical Insights"
             BackgroundColor="{AppThemeBinding Light={StaticResource ThemeBackgroundLight}, Dark={StaticResource ThemeBackgroundDark}}">
    <app:RootLayout x:Name="PageLayout" CurrentPath="/blog">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">
                <Label Text="Clinical Insights" FontSize="32" FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource ThemePrimaryLight}, Dark={StaticResource ThemePrimaryDark}}" />
                <Label Text="Pharmaceutical updates, clinical research, and healthcare wellness strategies."
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
                <HorizontalStackLayout x:Name="CategoryButtons" Spacing="8" />
                <utility:PostButton x:Name="PostPublisher" />
                <utility:Posts x:Name="PostList" Category="General" HeightRequest="680" />
            </VerticalStackLayout>
        </ScrollView>
    </app:RootLayout>
</ContentPage>
