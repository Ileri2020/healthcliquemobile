<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:app="clr-namespace:EEE.ClientApp"
             x:Class="EEE.ClientApp.Pages.AdminPage"
             Title="Administration"
             BackgroundColor="{AppThemeBinding Light={StaticResource ThemeBackgroundLight}, Dark={StaticResource ThemeBackgroundDark}}">
    <app:RootLayout x:Name="PageLayout" CurrentPath="/admin">
        <ScrollView>
            <VerticalStackLayout x:Name="Workspace" Padding="16" Spacing="14" />
        </ScrollView>
    </app:RootLayout>
</ContentPage>
