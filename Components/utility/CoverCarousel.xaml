<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.CoverCarousel"
             x:Name="Root">
    <Grid HeightRequest="{Binding Height, Source={x:Reference Root}}">
        <CollectionView x:Name="CardCollection"
                        ItemsSource="{Binding Cards, Source={x:Reference Root}}"
                        ItemsLayout="HorizontalList"
                        HorizontalScrollBarVisibility="Never"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border WidthRequest="{Binding CardWidth, Source={x:Reference Root}}"
                            Margin="8"
                            Padding="20"
                            Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}">
                        <Label Text="{Binding .}"
                               FontSize="24"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <HorizontalStackLayout Spacing="8" Padding="12" VerticalOptions="End" HorizontalOptions="Center">
            <ui:Button Text="Prev" Variant="Secondary" Command="{Binding PreviousCommand, Source={x:Reference Root}}" IsVisible="{Binding HasCards, Source={x:Reference Root}}" />
            <ui:Button Text="Next" Variant="Secondary" Command="{Binding NextCommand, Source={x:Reference Root}}" IsVisible="{Binding HasCards, Source={x:Reference Root}}" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
