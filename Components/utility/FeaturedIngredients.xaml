<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.FeaturedIngredients"
             x:Name="Root">
    <VerticalStackLayout Padding="14" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Shop by Ingredient" FontSize="26" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
                <Label Text="Explore ingredients found in our products."
                       TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
            </VerticalStackLayout>
            <ui:Button Grid.Column="1" Text="Refresh" Variant="Outline" Command="{Binding RefreshCommand, Source={x:Reference Root}}" />
        </Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading, Source={x:Reference Root}}"
                           IsVisible="{Binding IsLoading, Source={x:Reference Root}}"
                           Color="{AppThemeBinding Light={StaticResource ThemePrimaryLight}, Dark={StaticResource ThemePrimaryDark}}" />
        <Label Text="{Binding StatusMessage, Source={x:Reference Root}}" IsVisible="{Binding HasStatus, Source={x:Reference Root}}"
               TextColor="{AppThemeBinding Light={StaticResource ThemeDestructiveLight}, Dark={StaticResource ThemeDestructiveDark}}" />
        <CollectionView ItemsSource="{Binding Ingredients, Source={x:Reference Root}}" HeightRequest="290">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border WidthRequest="200" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                            StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="8">
                            <Image Source="{Binding ImageUrl}" HeightRequest="170" Aspect="AspectFill" />
                            <VerticalStackLayout Padding="10" Spacing="6">
                                <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
                                <ui:Badge Text="{Binding CountText}" />
                                <ui:Button Text="Explore" Variant="Outline"
                                           Command="{Binding Source={x:Reference Root}, Path=SelectCommand}"
                                           CommandParameter="{Binding Ingredient}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
