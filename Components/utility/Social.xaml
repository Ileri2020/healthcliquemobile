<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.Components.Utility.Social"
             x:Name="Root">
    <CollectionView ItemsSource="{Binding Items, Source={x:Reference Root}}"
                    SelectionMode="Single"
                    SelectionChanged="OnSelectionChanged"
                    ItemsLayout="HorizontalList"
                    HorizontalScrollBarVisibility="Never">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Padding="10"
                        Margin="2"
                        Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}">
                    <Label Text="{Binding IconText}"
                           SemanticProperties.Description="{Binding Name}"
                           TextColor="{AppThemeBinding Light={StaticResource ThemePrimaryLight}, Dark={StaticResource ThemePrimaryDark}}" />
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>
