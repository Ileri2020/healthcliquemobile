<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.CommonMedications"
             x:Name="Root">
    <VerticalStackLayout Padding="14" Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label Text="Our Curated Selection" FontSize="12" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource ThemePrimaryLight}, Dark={StaticResource ThemePrimaryDark}}" />
                <Label Text="Featured Products" FontSize="26" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
            </VerticalStackLayout>
            <ui:Button Grid.Column="1" Text="Refresh" Variant="Outline" Command="{Binding RefreshCommand, Source={x:Reference Root}}" />
        </Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading, Source={x:Reference Root}}" IsVisible="{Binding IsLoading, Source={x:Reference Root}}"
                           Color="{AppThemeBinding Light={StaticResource ThemePrimaryLight}, Dark={StaticResource ThemePrimaryDark}}" />
        <Label Text="{Binding StatusMessage, Source={x:Reference Root}}" IsVisible="{Binding HasStatus, Source={x:Reference Root}}"
               TextColor="{AppThemeBinding Light={StaticResource ThemeDestructiveLight}, Dark={StaticResource ThemeDestructiveDark}}" />
        <CollectionView ItemsSource="{Binding Products, Source={x:Reference Root}}" HeightRequest="340">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border WidthRequest="210" Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}">
                        <VerticalStackLayout Spacing="8">
                            <Image Source="{Binding Images[0]}" HeightRequest="160" Aspect="AspectFill" />
                            <VerticalStackLayout Padding="10" Spacing="6">
                                <Label Text="{Binding Category.Name}" FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
                                <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
                                <Label Text="{Binding PriceText}" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource ThemePrimaryLight}, Dark={StaticResource ThemePrimaryDark}}" />
                                <ui:Button Text="Add to cart" Variant="Primary"
                                           Command="{Binding Source={x:Reference Root}, Path=AddToCartCommand}"
                                           CommandParameter="{Binding Product}" />
                                <ui:Button Text="{Binding FeaturedButtonText}" Variant="Outline"
                                           IsVisible="{Binding Source={x:Reference Root}, Path=IsAdmin}"
                                           Command="{Binding Source={x:Reference Root}, Path=ToggleFeaturedCommand}"
                                           CommandParameter="{Binding Product}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
