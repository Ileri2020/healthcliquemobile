<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utility="clr-namespace:EEE.Components.Utility"
             x:Class="EEE.Components.Utility.Cart"
             x:Name="Root">
    <utility:CartClient x:Name="Client"
                        ApiBaseUrl="{Binding ApiBaseUrl, Source={x:Reference Root}}"
                        UserId="{Binding UserId, Source={x:Reference Root}}"
                        UserRole="{Binding UserRole, Source={x:Reference Root}}"
                        Items="{Binding Items, Source={x:Reference Root}}" />
</ContentView>
