<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.ContactForm"
             x:Name="Root">
    <VerticalStackLayout Padding="24"
                         Spacing="16"
                         BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}">
        <Label Text="Message Us"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <ui:Input Placeholder="Username"
                      Text="{Binding Username, Source={x:Reference Root}, Mode=TwoWay}" />
            <ui:Input Grid.Column="1"
                      Placeholder="Email address"
                      Keyboard="Email"
                      Text="{Binding Email, Source={x:Reference Root}, Mode=TwoWay}" />
        </Grid>
        <ui:Select Title="Message category"
                   ItemsSource="{Binding Categories, Source={x:Reference Root}}"
                   SelectedItem="{Binding Category, Source={x:Reference Root}, Mode=TwoWay}" />
        <ui:TextArea Placeholder="Type your message here"
                      Text="{Binding Message, Source={x:Reference Root}, Mode=TwoWay}"
                      MinimumHeightRequest="120" />
        <Label Text="{Binding StatusMessage, Source={x:Reference Root}}"
               IsVisible="{Binding HasStatus, Source={x:Reference Root}}"
               TextColor="{Binding StatusColor, Source={x:Reference Root}}" />
        <ui:Button Text="{Binding SubmitText, Source={x:Reference Root}}"
                   IsEnabled="{Binding CanSubmit, Source={x:Reference Root}}"
                   Command="{Binding SubmitCommand, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</ContentView>
