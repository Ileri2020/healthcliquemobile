<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.Nav"
             x:Name="Root">
    <CollectionView ItemsSource="{Binding Items, Source={x:Reference Root}}"
                    SelectionMode="Single"
                    SelectionChanged="OnSelectionChanged"
                    ItemsLayout="HorizontalList"
                    HorizontalScrollBarVisibility="Never">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <ui:Button Text="{Binding Name}"
                           Variant="Ghost"
                           Command="{Binding NavigateCommand, Source={x:Reference Root}}"
                           CommandParameter="{Binding .}" />
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>
