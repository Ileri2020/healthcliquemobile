<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.ProfileCards"
             x:Name="Root">
    <ui:Card WidthRequest="224" CardPadding="0">
        <ui:Card.BodyContent>
            <VerticalStackLayout Spacing="0">
                <Grid HeightRequest="116" BackgroundColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}">
                    <ui:Avatar Size="100" Source="{Binding ProfileImageSource, Source={x:Reference Root}}"
                               FallbackText="{Binding Name, Source={x:Reference Root}}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>
                <VerticalStackLayout Padding="12" Spacing="4">
                    <Label Text="{Binding Name, Source={x:Reference Root}}" FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource ThemeAccentLight}, Dark={StaticResource ThemeAccentDark}}" />
                    <Label Text="{Binding Title, Source={x:Reference Root}}" FontSize="13"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ui:Card.BodyContent>
    </ui:Card>
</ContentView>
