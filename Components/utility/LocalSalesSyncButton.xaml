<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.LocalSalesSyncButton"
             x:Name="Root">
    <ui:Button IsVisible="{Binding IsLocal, Source={x:Reference Root}}"
               Text="{Binding ButtonText, Source={x:Reference Root}}"
               Variant="Outline"
               IsEnabled="{Binding CanSync, Source={x:Reference Root}}"
               Command="{Binding SyncCommand, Source={x:Reference Root}}"
               HorizontalOptions="{Binding LayoutOptions, Source={x:Reference Root}}" />
</ContentView>
