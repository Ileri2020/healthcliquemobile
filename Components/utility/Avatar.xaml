<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.Avatar"
             x:Name="Root">
    <ui:Avatar Source="{Binding Source, Source={x:Reference Root}}"
               FallbackText="{Binding FallbackText, Source={x:Reference Root}}"
               Size="{Binding Size, Source={x:Reference Root}}" />
</ContentView>
