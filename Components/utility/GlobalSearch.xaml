<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.GlobalSearch"
             x:Name="Root">
    <VerticalStackLayout Spacing="6">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ui:Input Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                      Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}"
                      ReturnType="Search" />
            <ui:Button Grid.Column="1" Text="Search" Command="{Binding SearchCommand, Source={x:Reference Root}}" />
        </Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Picker Title="Category" ItemsSource="{Binding Categories, Source={x:Reference Root}}"
                    SelectedItem="{Binding SelectedCategory, Source={x:Reference Root}, Mode=TwoWay}"
                    TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}"
                    TitleColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
            <Picker Grid.Column="1" Title="Brand" ItemsSource="{Binding Brands, Source={x:Reference Root}}"
                    SelectedItem="{Binding SelectedBrand, Source={x:Reference Root}, Mode=TwoWay}"
                    TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}"
                    TitleColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
        </Grid>
        <Picker Title="Price range" ItemsSource="{Binding PriceRanges, Source={x:Reference Root}}"
                SelectedItem="{Binding SelectedPriceRange, Source={x:Reference Root}, Mode=TwoWay}"
                TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}"
                TitleColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
        <ActivityIndicator IsRunning="{Binding IsLoading, Source={x:Reference Root}}"
                           IsVisible="{Binding IsLoading, Source={x:Reference Root}}"
                           Color="{AppThemeBinding Light={StaticResource ThemePrimaryLight}, Dark={StaticResource ThemePrimaryDark}}" />
        <CollectionView ItemsSource="{Binding Results, Source={x:Reference Root}}"
                        IsVisible="{Binding ShowResults, Source={x:Reference Root}}"
                        MaximumHeightRequest="440">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="10" Padding="8">
                        <Image Source="{Binding ImageUrl}" WidthRequest="52" HeightRequest="52" Aspect="AspectFill" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
                            <Label Text="{Binding Category.Name}" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
                        </VerticalStackLayout>
                        <ui:Button Grid.Column="2" Text="{Binding PriceLabel}" Variant="Outline"
                                   Command="{Binding Source={x:Reference Root}, Path=SelectProductCommand}"
                                   CommandParameter="{Binding Product}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Text="{Binding StatusMessage, Source={x:Reference Root}}"
               IsVisible="{Binding HasStatus, Source={x:Reference Root}}"
               TextColor="{AppThemeBinding Light={StaticResource ThemeDestructiveLight}, Dark={StaticResource ThemeDestructiveDark}}" />
    </VerticalStackLayout>
</ContentView>
