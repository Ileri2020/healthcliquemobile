<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.TestimonialProp"
             x:Name="Root">
    <ui:Card WidthRequest="320" CardPadding="14">
        <ui:Card.BodyContent>
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="10">
                    <ui:Avatar Size="48" Source="{Binding Avatar, Source={x:Reference Root}}"
                               FallbackText="{Binding Name, Source={x:Reference Root}}" />
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Name, Source={x:Reference Root}}" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
                        <Label Text="{Binding Handle, Source={x:Reference Root}}" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Label Text="{Binding Text, Source={x:Reference Root}}" FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
                <ui:Button Text="Read more" Variant="Ghost"
                           IsVisible="{Binding HasLink, Source={x:Reference Root}}"
                           Command="{Binding OpenLinkCommand, Source={x:Reference Root}}" />
            </VerticalStackLayout>
        </ui:Card.BodyContent>
    </ui:Card>
</ContentView>
