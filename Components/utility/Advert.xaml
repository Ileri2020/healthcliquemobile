<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.Advert"
             x:Name="Root">
    <VerticalStackLayout Spacing="12">
        <CarouselView ItemsSource="{Binding ActiveAdverts, Source={x:Reference Root}}"
                      IsVisible="{Binding HasActiveAdverts, Source={x:Reference Root}}"
                      HeightRequest="72">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14" Stroke="{StaticResource ThemeTransparent}" StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}">
                        <Label Text="{Binding Text}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryForegroundLight}, Dark={StaticResource ThemeSecondaryForegroundDark}}" />
                    </Border>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
        <VerticalStackLayout IsVisible="{Binding IsAdmin, Source={x:Reference Root}}" Spacing="10">
            <Label Text="Advertisement messages" FontSize="20" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
            <ui:Input Placeholder="New advertisement text" Text="{Binding NewText, Source={x:Reference Root}, Mode=TwoWay}" />
            <ui:Button Text="Add advertisement" Command="{Binding AddCommand, Source={x:Reference Root}}" IsEnabled="{Binding CanModify, Source={x:Reference Root}}" />
            <ui:Button Text="Refresh" Variant="Outline" Command="{Binding RefreshCommand, Source={x:Reference Root}}" IsEnabled="{Binding CanModify, Source={x:Reference Root}}" />
            <CollectionView ItemsSource="{Binding Adverts, Source={x:Reference Root}}" HeightRequest="240">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="2"
                                Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                                StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Text}" TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <ui:Button Text="Save" Variant="Outline"
                                               Command="{Binding Source={x:Reference Root}, Path=SaveCommand}"
                                               CommandParameter="{Binding .}" />
                                    <ui:Button Grid.Column="1" Text="Delete" Variant="Destructive"
                                               Command="{Binding Source={x:Reference Root}, Path=DeleteCommand}"
                                               CommandParameter="{Binding .}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
        <Label Text="{Binding StatusMessage, Source={x:Reference Root}}" IsVisible="{Binding HasStatus, Source={x:Reference Root}}"
               TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
    </VerticalStackLayout>
</ContentView>
