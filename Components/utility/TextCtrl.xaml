<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.Components.Utility.TextCtrl"
             x:Name="Root">
    <VerticalStackLayout Spacing="2">
        <Label x:Name="AnimatedText" Text="{Binding DisplayText, Source={x:Reference Root}}"
               HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
        <Label Text="{Binding DisplayPage, Source={x:Reference Root}}" FontSize="12"
               HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
    </VerticalStackLayout>
</ContentView>
