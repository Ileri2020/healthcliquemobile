<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.ConcernGrid"
             x:Name="Root">
    <VerticalStackLayout Spacing="10" Padding="16">
        <Label Text="Shop by Health Concern" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
        <Label Text="Find exactly what you need for your specific wellness goals" HorizontalTextAlignment="Center"
               TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
        <CollectionView ItemsSource="{Binding Concerns, Source={x:Reference Root}}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="{Binding Columns, Source={x:Reference Root}}" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="5" Padding="12"
                            Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding IconText}" FontSize="22" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemePrimaryLight}, Dark={StaticResource ThemePrimaryDark}}" />
                            <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}" />
                            <ui:Button Text="Shop" Variant="Ghost"
                                       Command="{Binding Source={x:Reference Root}, Path=SelectCommand}"
                                       CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
