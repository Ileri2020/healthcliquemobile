<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.LocalOperationModeToggle"
             x:Name="Root">
    <Grid IsVisible="{Binding IsLocal, Source={x:Reference Root}}"
          ColumnDefinitions="*,*"
          Padding="4"
          ColumnSpacing="4"
          HorizontalOptions="{Binding LayoutOptions, Source={x:Reference Root}}"
          BackgroundColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}">
        <ui:Button Text="Online"
                   Variant="{Binding OnlineVariant, Source={x:Reference Root}}"
                   Command="{Binding SetOnlineCommand, Source={x:Reference Root}}" />
        <ui:Button Grid.Column="1" Text="Offline"
                   Variant="{Binding OfflineVariant, Source={x:Reference Root}}"
                   Command="{Binding SetOfflineCommand, Source={x:Reference Root}}" />
    </Grid>
</ContentView>
