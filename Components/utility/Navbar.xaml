<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.Components.Utility.Navbar"
             x:Name="Root">
    <VerticalStackLayout Spacing="8"
                         BackgroundColor="{AppThemeBinding Light={StaticResource ThemeBackgroundLight}, Dark={StaticResource ThemeBackgroundDark}}">
        <Grid ColumnDefinitions="Auto,*,Auto"
              Padding="12,8"
              ColumnSpacing="12">
            <ContentView Content="{Binding SideNavigation, Source={x:Reference Root}}" VerticalOptions="Center" />
            <ContentView Grid.Column="1" Content="{Binding BrandContent, Source={x:Reference Root}}" VerticalOptions="Center" />
            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                <ContentView Content="{Binding NavigationContent, Source={x:Reference Root}}" />
                <ContentView Content="{Binding ActionsContent, Source={x:Reference Root}}" />
            </HorizontalStackLayout>
        </Grid>
        <ContentView Content="{Binding BannerContent, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</ContentView>
