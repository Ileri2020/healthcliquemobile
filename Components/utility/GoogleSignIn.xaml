<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.GoogleSignIn"
             x:Name="Root">
    <ui:Button Text="{Binding ButtonText, Source={x:Reference Root}}"
               Variant="Outline"
               IsEnabled="{Binding CanSignIn, Source={x:Reference Root}}"
               Command="{Binding SignInCommand, Source={x:Reference Root}}" />
</ContentView>
