<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:EEE.Components.UI"
             x:Class="EEE.Components.Utility.Auth"
             x:Name="Root">
    <VerticalStackLayout Spacing="12">
        <ui:Input Placeholder="Email address" Text="{Binding Email, Source={x:Reference Root}, Mode=TwoWay}" Keyboard="Email" />
        <ui:Input Placeholder="Password" Text="{Binding Password, Source={x:Reference Root}, Mode=TwoWay}" IsPassword="True" />
        <Label Text="{Binding StatusMessage, Source={x:Reference Root}}"
               IsVisible="{Binding HasStatus, Source={x:Reference Root}}"
               TextColor="{AppThemeBinding Light={StaticResource ThemeDestructiveLight}, Dark={StaticResource ThemeDestructiveDark}}" />
        <ui:Button Text="{Binding SubmitText, Source={x:Reference Root}}"
                   Command="{Binding SubmitCommand, Source={x:Reference Root}}"
                   IsEnabled="{Binding CanSubmit, Source={x:Reference Root}}" />
    </VerticalStackLayout>
</ContentView>
