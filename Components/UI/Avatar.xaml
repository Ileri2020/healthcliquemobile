<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.Components.UI.Avatar"
             x:Name="Root">
    <Border WidthRequest="{Binding Size, Source={x:Reference Root}}"
            HeightRequest="{Binding Size, Source={x:Reference Root}}"
            Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
            StrokeShape="Ellipse"
            StrokeThickness="1"
            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeMutedLight}, Dark={StaticResource ThemeMutedDark}}">
        <Grid>
            <Image Source="{Binding Source, Source={x:Reference Root}}"
                   Aspect="AspectFill"
                   IsVisible="{Binding HasSource, Source={x:Reference Root}}" />
            <Label Text="{Binding FallbackText, Source={x:Reference Root}}"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   IsVisible="{Binding HasFallback, Source={x:Reference Root}}"
                   TextColor="{AppThemeBinding Light={StaticResource ThemeMutedForegroundLight}, Dark={StaticResource ThemeMutedForegroundDark}}" />
        </Grid>
    </Border>
</ContentView>
