<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.Components.UI.Label"
             x:Name="Root">
    <Label x:Name="NativeLabel"
           Text="{Binding Text, Source={x:Reference Root}}"
           FontSize="{Binding FontSize, Source={x:Reference Root}}"
           FontAttributes="{Binding FontAttributes, Source={x:Reference Root}}"
           TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}"
           HorizontalTextAlignment="{Binding HorizontalTextAlignment, Source={x:Reference Root}}"
           LineBreakMode="{Binding LineBreakMode, Source={x:Reference Root}}" />
</ContentView>
