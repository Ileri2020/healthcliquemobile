<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.Components.UI.HoverCard"
             x:Name="Root">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
        <Grid.GestureRecognizers>
            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
        </Grid.GestureRecognizers>
        <ContentView Grid.Row="0" Content="{Binding TriggerContent, Source={x:Reference Root}}">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTriggerTapped" />
            </ContentView.GestureRecognizers>
        </ContentView>
        <Border Grid.Row="1"
                IsVisible="{Binding IsOpen, Source={x:Reference Root}}"
                Padding="16"
                Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}"
                ZIndex="20">
            <ContentView Content="{Binding CardContent, Source={x:Reference Root}}" />
        </Border>
    </Grid>
</ContentView>
