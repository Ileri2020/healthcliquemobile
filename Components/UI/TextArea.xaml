<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.Components.UI.TextArea"
             x:Name="Root">
    <Border Padding="10"
            Stroke="{AppThemeBinding Light={StaticResource ThemeInputLight}, Dark={StaticResource ThemeInputDark}}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}">
        <Editor Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                IsEnabled="{Binding IsEnabled, Source={x:Reference Root}}"
                MaxLength="{Binding MaxLength, Source={x:Reference Root}}"
                AutoSize="TextChanges"
                MinimumHeightRequest="{Binding MinimumHeightRequest, Source={x:Reference Root}}" />
    </Border>
</ContentView>
