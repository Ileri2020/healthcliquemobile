<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="EEE.Components.UI.Select"
             x:Name="Root">
    <Grid>
        <material:DropdownField Title="{Binding Title, Source={x:Reference Root}}"
                                ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                                SelectedItem="{Binding SelectedItem, Source={x:Reference Root}, Mode=TwoWay}"
                                AllowClear="{Binding AllowClear, Source={x:Reference Root}}"
                                IsEnabled="{Binding IsEnabled, Source={x:Reference Root}}"
                                IsVisible="{Binding HasDefaultContent, Source={x:Reference Root}}" />
        <ContentView Content="{Binding CustomContent, Source={x:Reference Root}}"
                     IsVisible="{Binding HasCustomContent, Source={x:Reference Root}}" />
    </Grid>
</ContentView>
