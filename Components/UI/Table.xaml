<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.Components.UI.Table"
             x:Name="Root">
    <Border Stroke="{AppThemeBinding Light={StaticResource ThemeBorderLight}, Dark={StaticResource ThemeBorderDark}}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSurfaceLight}, Dark={StaticResource ThemeSurfaceDark}}">
        <VerticalStackLayout>
            <ContentView Content="{Binding HeaderContent, Source={x:Reference Root}}" />
            <ContentView Content="{Binding BodyContent, Source={x:Reference Root}}"
                         IsVisible="{Binding HasCustomBody, Source={x:Reference Root}}" />
            <CollectionView ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                            ItemTemplate="{Binding ItemTemplate, Source={x:Reference Root}}"
                            SelectionMode="{Binding SelectionMode, Source={x:Reference Root}}"
                            SelectedItem="{Binding SelectedItem, Source={x:Reference Root}, Mode=TwoWay}"
                            EmptyView="{Binding EmptyView, Source={x:Reference Root}}"
                            IsVisible="{Binding HasDefaultBody, Source={x:Reference Root}}" />
            <ContentView Content="{Binding FooterContent, Source={x:Reference Root}}" />
            <ContentView Content="{Binding CaptionContent, Source={x:Reference Root}}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
