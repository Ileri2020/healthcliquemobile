<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.Components.UI.Badge"
             x:Name="Root">
    <Border Padding="10,4"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 10"
            BackgroundColor="{AppThemeBinding Light={StaticResource ThemeSecondaryLight}, Dark={StaticResource ThemeSecondaryDark}}">
        <Label Text="{Binding Text, Source={x:Reference Root}}"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource ThemeSecondaryForegroundLight}, Dark={StaticResource ThemeSecondaryForegroundDark}}" />
    </Border>
</ContentView>
