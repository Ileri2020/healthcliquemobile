<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="EEE.Components.UI.Input"
             x:Name="Root">
    <material:TextField Title="{Binding Placeholder, Source={x:Reference Root}}"
                        Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                        Keyboard="{Binding Keyboard, Source={x:Reference Root}}"
                        IsPassword="{Binding IsPassword, Source={x:Reference Root}}"
                        IsEnabled="{Binding IsEnabled, Source={x:Reference Root}}"
                        MaxLength="{Binding MaxLength, Source={x:Reference Root}}"
                        AllowClear="{Binding AllowClear, Source={x:Reference Root}}"
                        ReturnType="{Binding ReturnType, Source={x:Reference Root}}" />
</ContentView>
