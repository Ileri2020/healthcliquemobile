<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.Components.UI.CheckBox"
             x:Name="Root">
    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
        <CheckBox IsChecked="{Binding IsChecked, Source={x:Reference Root}, Mode=TwoWay}"
                  IsEnabled="{Binding IsEnabled, Source={x:Reference Root}}"
                  Color="{AppThemeBinding Light={StaticResource ThemePrimaryLight}, Dark={StaticResource ThemePrimaryDark}}" />
        <Label Text="{Binding Text, Source={x:Reference Root}}"
               VerticalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource ThemeForegroundLight}, Dark={StaticResource ThemeForegroundDark}}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleCommand, Source={x:Reference Root}}" />
            </Label.GestureRecognizers>
        </Label>
    </HorizontalStackLayout>
</ContentView>
