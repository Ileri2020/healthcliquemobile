<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.Components.UI.Button"
             x:Name="Root">
    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
        <ContentView Content="{Binding LeadingContent, Source={x:Reference Root}}" VerticalOptions="Center" />
        <Button x:Name="NativeButton"
                Text="{Binding Text, Source={x:Reference Root}}"
                Command="{Binding Command, Source={x:Reference Root}}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}"
                IsEnabled="{Binding IsEnabled, Source={x:Reference Root}}"
                CornerRadius="8"
                Padding="16,10"
                MinimumHeightRequest="44" />
        <ContentView Content="{Binding TrailingContent, Source={x:Reference Root}}" VerticalOptions="Center" />
    </HorizontalStackLayout>
</ContentView>
